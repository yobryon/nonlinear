{
  "name": "nonlinear",
  "private": true,
  "version": "0.1.0",
  "description": "Self-hostable, containerized Linear clone",
  "scripts": {
    "dev": "pnpm --parallel --filter @nonlinear/api --filter @nonlinear/web dev",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "lint": "prettier --check \"**/*.{ts,tsx,css,json,md}\"",
    "format": "prettier --write \"**/*.{ts,tsx,css,json,md}\""
  },
  "devDependencies": {
    "prettier": "^3.3.3",
    "typescript": "^5.6.3"
  },
  "packageManager": "pnpm@9.15.2",
  "engines": {
    "node": ">=22"
  }
}
